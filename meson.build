rmlui_public_inc = include_directories('include', is_system: true)

rmlui_lib = static_library(
    'rmlui',
    rmlui_sources,
    include_directories: rmlui_public_inc,
    dependencies: freetype_dep,
    cpp_args: rmlui_defines + [
        '-DRMLUI_FONT_ENGINE_FREETYPE',
        '-DRMLUI_VERSION="6.2-bs.1"',
        '-w',
    ],
    # The project builds unity=on; RmlUi's sources are not unity-clean, so opt out.
    override_options: ['unity=off'],
)

rmlui_dep = declare_dependency(
    link_with: rmlui_lib,
    include_directories: rmlui_public_inc,
    dependencies: freetype_dep,
    compile_args: rmlui_defines,
)

meson.override_dependency('rmlui', rmlui_dep)
