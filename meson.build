project(
    'rmlui',
    'cpp',
    version: '6.2',
    license: 'MIT',
    meson_version: '>= 1.3.0',
    default_options: [
        'warning_level=0',
        'default_library=static',
    ],
)

# Barely-Soldered fork of RmlUi 6.2, restructured for meson-only building:
#   - public headers under include/rmlui/, sources under src/, snake_case throughout
#   - non-local includes use angle brackets (<rmlui/...>)
#   - CMake / Samples / Tests / Backends / Lua / SVG / Lottie cruft removed
#   - FreeType is the font engine; the Debugger plugin is included
#
# Build defines:
#   RMLUI_CUSTOM_RTTI : MANDATORY. Consumers build with cpp_rtti = false (-fno-rtti),
#                       so RmlUi's default dynamic_cast/typeid RTTI will not compile.
#                       Switches RmlUi to its own RTTI implementation. Propagated to
#                       consumers (ABI must match).
#   RMLUI_STATIC_LIB  : static linkage; makes the RMLUI_API export macros no-ops.
#                       Propagated to consumers.
#   RMLUI_FONT_ENGINE_FREETYPE : lib-internal only. Gates registration of the default
#                       FreeType font engine in core.cpp. Without it the library builds
#                       but never registers a font engine (text silently fails to render).
#   RMLUI_VERSION     : cosmetic; reported by Rml::GetVersion().

rmlui_defines = ['-DRMLUI_STATIC_LIB', '-DRMLUI_CUSTOM_RTTI']

# FreeType font engine dependency. static per the project's self-contained-install regime;
# its transitive archives (harfbuzz, png, z, brotli, ...) resolve at final-executable link.
freetype_dep = dependency('freetype2', static: true)

